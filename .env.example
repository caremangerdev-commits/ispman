# Supabase project settings -> API
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row level security — never prefix this with
# NEXT_PUBLIC_ and never import lib/supabase/admin.ts from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FreeRADIUS MySQL bridge (server-side only).
RADIUS_DB_HOST=
RADIUS_DB_USER=
RADIUS_DB_PASSWORD=
RADIUS_DB_NAME=radius

# Router tunnels (migration 0033; docs/wireguard-tunnels.md). The server end
# of every router's WireGuard tunnel, as a router's config needs to name it.
# The PUBLIC key only — the server's private key stays in a root-only file on
# the box. Unset, routers can be added but no key can be saved.
WG_SERVER_PUBLIC_KEY=
# What routers dial: the box's Elastic IP (or a hostname that resolves to it).
WG_SERVER_ENDPOINT=
# WG_SERVER_PORT=51820
# Written every 30 seconds by the root job (deploy/wireguard/ispman-wg-sync).
# Unset, the settings card says tunnel status is not available.
# WG_HANDSHAKES_FILE=/var/lib/ispman/wg-handshakes
# How the root job's last run went, for the platform overview.
# WG_SYNC_STATUS_FILE=/var/lib/ispman/wg-sync.json
# The secret the root job sends to /api/tunnels/peers; the same value goes in
# /etc/ispman/wg-sync.env. SET IT ONLY ONCE THE JOB AND THE RADIUS SERVER'S
# ON-DEMAND CLIENTS ARE INSTALLED: from then on nobody is handed a server block,
# because the job applies every change itself. Unset, the operator runs them.
# TUNNEL_SYNC_SECRET=PASTE-openssl-rand-hex-32

# Daily billing engine (migration 0024). Both tickers run under pm2 and post
# to the app; see docs/billing-engine.md.
#
# BILLING_ENGINE_ENABLED is the environment kill switch: anything but "true"
# makes /api/billing/tick refuse with 503, whatever the per-company modes say.
# Leave it unset on a fresh deploy.
BILLING_ENGINE_ENABLED=false
# What stops anything but worker/billing-ticker.mjs calling the tick route.
BILLING_TICK_SECRET=PASTE-openssl-rand-hex-32
# Defaults shown; only set these to change them.
# BILLING_TICK_URL=http://127.0.0.1:3000/api/billing/tick
# BILLING_TICK_SECONDS=3600
