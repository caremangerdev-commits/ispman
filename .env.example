# Supabase project settings -> API
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row level security — never prefix this with
# NEXT_PUBLIC_ and never import lib/supabase/admin.ts from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FreeRADIUS MySQL bridge (server-side only).
RADIUS_DB_HOST=
RADIUS_DB_USER=
RADIUS_DB_PASSWORD=
RADIUS_DB_NAME=radius

# Daily billing engine (migration 0024). Both tickers run under pm2 and post
# to the app; see docs/billing-engine.md.
#
# BILLING_ENGINE_ENABLED is the environment kill switch: anything but "true"
# makes /api/billing/tick refuse with 503, whatever the per-company modes say.
# Leave it unset on a fresh deploy.
BILLING_ENGINE_ENABLED=false
# What stops anything but worker/billing-ticker.mjs calling the tick route.
BILLING_TICK_SECRET=PASTE-openssl-rand-hex-32
# Defaults shown; only set these to change them.
# BILLING_TICK_URL=http://127.0.0.1:3000/api/billing/tick
# BILLING_TICK_SECONDS=3600
