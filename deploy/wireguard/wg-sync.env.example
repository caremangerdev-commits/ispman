# /etc/ispman/wg-sync.env — settings for ispman-wg-sync.
# Root only: chown root:root, chmod 600. It holds the shared secret.

# The same value as TUNNEL_SYNC_SECRET in ISPMan's .env.local.
# Make one with: openssl rand -hex 32
TUNNEL_SYNC_SECRET=PASTE-openssl-rand-hex-32

# Where ISPMan answers on this box. Direct to the app, never through Apache:
# the route refuses anything that is not a loopback call.
# ISPMAN_PEERS_URL=http://127.0.0.1:3000/api/tunnels/peers

# The range this job will accept peers in. ITS OWN COPY ON PURPOSE: the side
# with root decides what is allowed, and does not take the range from the app.
# Must agree with lib/tunnels/wireguard.ts.
TUNNEL_NETWORK=10.250.0.0/16
TUNNEL_SERVER_IP=10.250.0.1
WG_INTERFACE=wg-routers

# The mass-removal guard. More removals than this in one run, or any run that
# would remove every peer, are held until a person runs
#   ispman-wg-sync --allow-removals N
MAX_REMOVALS_PER_RUN=3
